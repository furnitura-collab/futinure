    "@types/multer": "2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@mebel/shared": "workspace:*",
