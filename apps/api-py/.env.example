NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mebel:mebel@localhost:5433/mebel?schema=public
REDIS_URL=redis://localhost:6380

# Kamida 32 belgi. Production'da: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# OTP kodlarini hash qilish uchun
OTP_PEPPER=change-me-otp-pepper-at-least-32-chars

# SMS: "console" (dev, kod logga chiqadi) yoki "eskiz"
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Dev uchun: shu raqamlarga SMS yuborilmaydi, kod doim 000000 (production'da bo'sh qoldiring)
OTP_TEST_PHONES=+998900000001,+998900000002,+998900000003,+998900000004,+998900000005

UPLOAD_DIR=./uploads

# Push: "console" (dev) yoki "expo"
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# Telegram: xodimlar guruhiga yangi buyurtma/chek haqida xabar. Ikkalasi bo'sh bo'lsa o'chiq
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_URL=http://localhost:3001
