{
  "expo": {
    "name": "Mebel Order",
    "slug": "mebel-order",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mebelorder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "uz.mebelorder.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF3C7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.mebelorder.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#b45309",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yetkazish manzilini aniqlash uchun joylashuvingiz kerak"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To'lov chekini yuklash uchun galereyaga ruxsat kerak",
          "cameraPermission": "Chekni suratga olish uchun kameraga ruxsat kerak"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b45309"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}