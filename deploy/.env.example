# cp .env.example .env — keyin qiymatlarni to'ldiring.
# Maxfiy qiymatlar: openssl rand -hex 32

# Domen (DNS A yozuvi server IP'siga qaragan bo'lsin). Bo'sh qoldirilsa — http://<IP>
DOMAIN=
ADMIN_URL=http://localhost/admin/

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_PEPPER=

# Sinov rejimi: SMS yuborilmaydi, test raqamlar uchun kod 000000, bo'sh bazaga demo ma'lumotlar yuklanadi.
# Haqiqiy foydalanuvchilar uchun DEMO_MODE=false, OTP_TEST_PHONES bo'sh, Eskiz va ADMIN_PHONE sozlanadi.
DEMO_MODE=true
# Birinchi super admin (har start'da tekshiriladi, bor bo'lsa tegilmaydi)
ADMIN_PHONE=
ADMIN_NAME=
# Super admin paroli (kamida 6 belgi). Faqat paroli hali yo'q bo'lsa o'rnatiladi; kirgach almashtirib, bu yerdan o'chiring
ADMIN_PASSWORD=
OTP_TEST_PHONES=+998900000001,+998900000002,+998900000003,+998900000004,+998900000005
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zaxira nusxalarni serverdan tashqariga yuborish (ixtiyoriy): rclone remote, masalan r2:mebel-backups
BACKUP_REMOTE=
